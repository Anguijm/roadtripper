# dependencies
node_modules/
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# env files
.env*.local

# debug
npm-debug.log*

# misc
.DS_Store
*.tsbuildinfo

# harness logs
.harness/logs/

# harness circuit breaker (local-only trigger file; never commit)
.harness_halt

# harness latest council output (regenerated each run; durable record lives in
# .harness/yolo_log.jsonl + .harness/memory/decisions/session-N-*.md)
.harness/last_council.md
.harness/.venv/

# Python bytecode caches in the harness scripts dir
.harness/scripts/__pycache__/
.harness/**/__pycache__/

# CI council monthly-budget counter (lives in GH Actions cache, not the repo;
# this guard prevents accidental commit of the local copy)
.budget/

# Written by .harness/hooks/post-commit after every commit. Tracking local
# session state meant every commit left the tree dirty, which blocked
# `git checkout` and `gh pr merge`. CLAUDE.md documented that as a known gotcha
# with a stash/unstash workaround for two years instead of ignoring the files.
.harness/session_state.json
.harness/yolo_log.jsonl
